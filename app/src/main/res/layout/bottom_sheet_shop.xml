<?xml version="1.0" encoding="utf-8"?>
<!-- Marché : solde + onglets (Couleurs / Thèmes de carte / Boosts) + liste d'articles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingEnd="@dimen/sheet_padding_h">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/shop_title"
                android:textAppearance="@style/TextAppearance.GeoMoneyHide.SheetTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/shop_subtitle"
                android:textAppearance="@style/TextAppearance.GeoMoneyHide.SheetSubtitle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shop_balance_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:background="@drawable/bg_coin_pill"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_m">

            <ImageView
                android:id="@+id/shop_balance_icon"
                android:layout_width="@dimen/coin_pill_icon"
                android:layout_height="@dimen/coin_pill_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coin_gold" />

            <TextView
                android:id="@+id/shop_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.GeoMoneyHide.CoinCounter"
                tools:text="125" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/shop_tabs"
        style="@style/Widget.GeoMoneyHide.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_palette"
            android:text="@string/shop_tab_colors" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_map"
            android:text="@string/shop_tab_themes" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_bolt"
            android:text="@string/shop_tab_boosts" />
    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hud_divider" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/shop_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/shop_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
