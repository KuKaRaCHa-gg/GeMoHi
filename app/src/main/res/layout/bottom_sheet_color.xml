<?xml version="1.0" encoding="utf-8"?>
<!-- Sélecteur de couleur des zones (BottomSheetDialog), piloté par UIManager. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingEnd="@dimen/sheet_padding_h"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/color_title"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SheetTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/color_subtitle"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SheetSubtitle" />

        <!-- Aperçu en direct sur une mini-carte -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GeoMoneyHide.ShopCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/preview_height"
            android:layout_marginTop="@dimen/space_l">

            <FrameLayout
                android:id="@+id/color_preview_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/color_preview_desc"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_preview_map" />

                <View
                    android:id="@+id/color_preview_zone"
                    android:layout_width="@dimen/preview_zone"
                    android:layout_height="@dimen/preview_zone"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/color_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/space_s"
                    android:background="@drawable/bg_coin_gain"
                    android:fontFeatureSettings="tnum"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/text_primary"
                    tools:text="#22C55E · 40 %" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Palette (articles du Marché) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/color_section_palette"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SectionLabel" />

        <LinearLayout
            android:id="@+id/swatch_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/swatch_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <!-- Teinte libre (article color_custom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_section_custom"
                android:textAppearance="@style/TextAppearance.GeoMoneyHide.SectionLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_unlock_custom"
                style="@style/Widget.GeoMoneyHide.Button.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_lock"
                tools:text="300"
                tools:visibility="visible" />
        </LinearLayout>

        <View
            android:id="@+id/color_hue_strip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hue_strip_height"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_l"
            android:importantForAccessibility="no" />

        <com.google.android.material.slider.Slider
            android:id="@+id/color_hue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/color_hue_desc"
            android:stepSize="1"
            android:value="120"
            android:valueFrom="0"
            android:valueTo="360" />

        <!-- Opacité -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/color_section_opacity"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SectionLabel" />

        <com.google.android.material.slider.Slider
            android:id="@+id/color_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:contentDescription="@string/color_opacity_desc"
            android:stepSize="1"
            android:value="30"
            android:valueFrom="5"
            android:valueTo="90" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_cancel"
                style="@style/Widget.GeoMoneyHide.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_apply"
                style="@style/Widget.GeoMoneyHide.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="2"
                android:text="@string/color_apply"
                app:icon="@drawable/ic_check" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
