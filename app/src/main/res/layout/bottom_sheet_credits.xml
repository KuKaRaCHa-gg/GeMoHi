<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingEnd="@dimen/sheet_padding_h"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="@dimen/credits_logo"
            android:layout_height="@dimen/credits_logo"
            android:background="@drawable/bg_bubble"
            android:backgroundTint="@color/coin_pill_bg">

            <ImageView
                android:id="@+id/credits_logo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coin_gold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SheetTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/credits_version"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SectionLabel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/credits_tagline"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SheetSubtitle" />

        <LinearLayout
            android:id="@+id/credits_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/credits_tech_title"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.SectionLabel" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:chipSpacingHorizontal="@dimen/space_s">

            <com.google.android.material.chip.Chip
                style="@style/Widget.GeoMoneyHide.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tech_maps"
                app:chipIcon="@drawable/ic_map" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.GeoMoneyHide.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tech_location"
                app:chipIcon="@drawable/ic_my_location" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.GeoMoneyHide.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tech_material"
                app:chipIcon="@drawable/ic_palette" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/credits_copyright"
            android:textAppearance="@style/TextAppearance.GeoMoneyHide.StatLabel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/credits_close"
            style="@style/Widget.GeoMoneyHide.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/action_close" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
