<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran principal : carte plein écran + HUD flottant en « verre sombre ».
    Les marges liées aux barres système sont appliquées par UIManager.bindViews().
    IDs utilisés par MapsActivity : ui_container, map, fab_refresh. Les autres sont internes à UIManager.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ui_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_900"
    tools:context=".MapsActivity">

    <!-- Carte Google Maps -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== HUD supérieur ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hud_card"
        style="@style/Widget.GeoMoneyHide.GlassCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hud_margin"
        android:layout_marginTop="@dimen/hud_margin"
        android:layout_marginEnd="@dimen/hud_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="560dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/hud_padding">

            <!-- En-tête : logo + titre + solde de pièces -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/hud_logo"
                    android:layout_height="@dimen/hud_logo"
                    android:background="@drawable/bg_bubble"
                    android:backgroundTint="@color/coin_pill_bg"
                    android:importantForAccessibility="noHideDescendants">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/hud_logo_desc"
                        android:src="@drawable/ic_explore"
                        app:tint="@color/gold_400" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.GeoMoneyHide.HudTitle"
                        tools:targetApi="28" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/hud_subtitle"
                        android:textAppearance="@style/TextAppearance.GeoMoneyHide.HudSubtitle" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hud_coin_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_coin_pill"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m">

                    <ImageView
                        android:id="@+id/hud_coin_icon"
                        android:layout_width="@dimen/coin_pill_icon"
                        android:layout_height="@dimen/coin_pill_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_coin_gold" />

                    <TextView
                        android:id="@+id/hud_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:fontFeatureSettings="tnum"
                        android:importantForAccessibility="no"
                        android:minWidth="20dp"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.GeoMoneyHide.CoinCounter"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Statistiques : surface + zones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/hud_surface_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.35"
                    android:background="@drawable/bg_tile"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_s">

                    <FrameLayout
                        android:layout_width="@dimen/stat_icon_bubble"
                        android:layout_height="@dimen/stat_icon_bubble"
                        android:background="@drawable/bg_bubble"
                        android:backgroundTint="@color/stat_surface_bg">

                        <ImageView
                            android:layout_width="@dimen/stat_icon"
                            android:layout_height="@dimen/stat_icon"
                            android:layout_gravity="center"
                            android:contentDescription="@string/hud_icon_surface_desc"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_globe"
                            app:tint="@color/accent_surface" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hud_surface"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.GeoMoneyHide.StatValue"
                            tools:text="12 km²" />

                        <TextView
                            android:id="@+id/hud_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.GeoMoneyHide.StatLabel"
                            tools:text="0,000 002 % de la Terre" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hud_cells_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_s">

                    <FrameLayout
                        android:layout_width="@dimen/stat_icon_bubble"
                        android:layout_height="@dimen/stat_icon_bubble"
                        android:background="@drawable/bg_bubble"
                        android:backgroundTint="@color/stat_cells_bg">

                        <ImageView
                            android:layout_width="@dimen/stat_icon"
                            android:layout_height="@dimen/stat_icon"
                            android:layout_gravity="center"
                            android:contentDescription="@string/hud_icon_cells_desc"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_grid"
                            app:tint="@color/accent_cells" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hud_cells"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.GeoMoneyHide.StatValue"
                            tools:text="12" />

                        <TextView
                            android:id="@+id/hud_cells_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.GeoMoneyHide.StatLabel"
                            tools:text="zones explorées" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Boosts actifs (pastilles ajoutées par UIManager.updateBoosts) -->
            <LinearLayout
                android:id="@+id/hud_boosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bulle animée « +N » sous le compteur de pièces -->
    <TextView
        android:id="@+id/hud_coin_gain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_l"
        android:alpha="0"
        android:background="@drawable/bg_coin_gain"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.GeoMoneyHide.CoinGain"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/hud_card"
        app:layout_constraintTop_toBottomOf="@id/hud_card"
        tools:text="+3"
        tools:visibility="visible" />

    <!-- ===================== Bouton de recentrage ===================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_refresh"
        style="@style/Widget.GeoMoneyHide.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_m"
        android:contentDescription="@string/action_recenter_desc"
        android:src="@drawable/ic_my_location"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="@id/bottom_bar" />

    <!-- ===================== Barre d'actions inférieure ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_bar"
        style="@style/Widget.GeoMoneyHide.GlassCard.Bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hud_margin"
        android:layout_marginEnd="@dimen/hud_margin"
        android:layout_marginBottom="@dimen/hud_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="560dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_s">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_shop"
                style="@style/Widget.GeoMoneyHide.BarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/action_shop_desc"
                android:text="@string/action_shop"
                app:icon="@drawable/ic_store"
                app:iconTint="@color/accent_shop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_color"
                style="@style/Widget.GeoMoneyHide.BarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:contentDescription="@string/action_color_desc"
                android:text="@string/action_color"
                app:icon="@drawable/ic_palette"
                app:iconTint="@color/accent_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_rules"
                style="@style/Widget.GeoMoneyHide.BarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:contentDescription="@string/action_rules_desc"
                android:text="@string/action_rules"
                app:icon="@drawable/ic_rules"
                app:iconTint="@color/accent_rules" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_credits"
                style="@style/Widget.GeoMoneyHide.BarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:contentDescription="@string/action_credits_desc"
                android:text="@string/action_credits"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/accent_credits" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
